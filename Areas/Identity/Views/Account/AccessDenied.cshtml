@{
    ViewData["Title"] = "Access denied";
}

<style>
    .denied-card {
        width: 100%;
        max-width: 460px;
        margin: 0 auto;
        padding: 36px 32px;
        text-align: center;
        background: var(--surface, #1a1a27);
        border: 1px solid var(--line, #2d2d42);
        border-radius: 14px;
        color: var(--text, #ececf6);
    }

    .denied-icon {
        display: grid;
        place-items: center;
        width: 72px;
        height: 72px;
        margin: 0 auto 20px;
        border-radius: 50%;
        background: rgba(200, 67, 79, .14);
        border: 1px solid rgba(200, 67, 79, .5);
        color: #ff8a93;
    }

        .denied-icon svg {
            width: 34px;
            height: 34px;
        }

    .denied-card h1 {
        margin: 0 0 10px;
        font-size: 28px;
    }

    .denied-card p {
        margin: 0 0 26px;
        color: var(--muted, #9a9cb5);
        font-size: 15px;
        line-height: 1.6;
    }

    .denied-actions {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .denied-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        padding: 0 16px;
        border: 1px solid var(--line, #2d2d42);
        border-radius: 8px;
        background: transparent;
        color: var(--text, #ececf6);
        font-weight: 600;
        text-decoration: none;
        transition: border-color .15s, filter .15s;
    }

        .denied-btn:hover {
            border-color: var(--accent, #e8b64c);
        }

        .denied-btn.primary {
            background: var(--accent, #e8b64c);
            border-color: var(--accent, #e8b64c);
            color: var(--accent-ink, #2a2005);
        }

            .denied-btn.primary:hover {
                filter: brightness(.93);
            }

        .denied-btn:focus-visible {
            outline: 2px solid var(--accent, #e8b64c);
            outline-offset: 2px;
        }

    @@media (max-width: 520px) {
        .denied-card {
            padding: 28px 20px;
        }

            .denied-card h1 {
                font-size: 24px;
            }
    }
</style>

<div class="denied-card" role="alert">
    <div class="denied-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24">
            <rect x="5" y="11" width="14" height="9" rx="2"></rect>
            <path d="M8 11V8a4 4 0 018 0v3"></path>
        </svg>
    </div>

    <h1>Access denied</h1>
    <p>You don't have permission to view this page. If you think this is a mistake, sign in with a different account or contact the administrator.</p>

    <div class="denied-actions">
        <a class="denied-btn primary" href="/Identity/Account/Register">Register</a>
        <a class="denied-btn" asp-action="Login">Sign in with another account</a>
    </div>
</div>