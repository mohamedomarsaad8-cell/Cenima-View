@model List<Cart>

@{
	ViewData["Title"] = "Shopping Cart";
}

<div class="cart-page">

	<div class="cart-header">
		<div>
			<span class="page-label">YOUR SELECTION</span>
			<h1>Shopping Cart</h1>
			<p>Review your movie tickets before checkout.</p>
		</div>

		<a asp-area="Customer" asp-controller="Home" asp-action="Index" class="continue-shopping">
			<i class="bi bi-arrow-left"></i>
			Continue Shopping
		</a>
	</div>

	<div class="cart-container">

		<div class="cart-items">

			<div class="cart-table-header">
				<span>Movie</span>
				<span>Quantity</span>
				<span>Price</span>
				<span>Subtotal</span>
			</div>

			@foreach (var item in Model)
			{
				<div class="cart-item">

					<div class="movie-info">

						<div class="movie-image">
							<img src="~/images/@item.Movie.MainImg" alt="@item.Movie.Name" />
						</div>

						<div class="movie-details">
							<h3>@item.Movie.Name</h3>
							<span>Movie Ticket</span>

							<a href="/Customer/Cart/Remove?MovieId=@item.MovieId" class="remove-btn">
								<i class="bi bi-trash"></i>
								Remove
							</a>
						</div>

					</div>

					<div class="quantity">

                
						<a href="/Customer/Cart/DecreaseQuantity?MovieId=@item.MovieId" class="quantity-btn">−</a>

						<span>@item.Quantity</span>

     
						<a href="/Customer/Cart/IncreaseQuantity?MovieId=@item.MovieId" class="quantity-btn">+</a>

					</div>

					<div class="price">
						$@item.Movie.Price.ToString("0.00")
					</div>

					<div class="subtotal">
						$@((item.Quantity * item.Movie.Price).ToString("0.00"))
					</div>

				</div>
			}

		</div>

		<div class="order-summary">

			<h2>Order Summary</h2>

			<div class="summary-row">
				<span>Subtotal</span>
				<span>$@Model.Sum(x => x.Quantity * x.Movie.Price).ToString("0.00")</span>
			</div>

			<div class="summary-row">
				<span>Additional Fees</span>
				<span>$0.00</span>
			</div>

			<div class="summary-divider"></div>

			<div class="summary-total">
				<span>Total</span>
				<span>$@Model.Sum(x => x.Quantity * x.Movie.Price).ToString("0.00")</span>
			</div>

			<form asp-controller="Cart" asp-action="Pay" method="post">
				<button type="submit" class="checkout-btn">
					Proceed to Pay
					<i class="bi bi-arrow-right"></i>
				</button>
			</form>

			<div class="secure-payment">
				<i class="bi bi-shield-check"></i>
				Secure Checkout
			</div>

		</div>

	</div>

</div>

<style>

	.cart-page {
		max-width: 1200px;
		margin: 50px auto;
		padding: 0 24px;
		color: var(--text);
	}

	.cart-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 35px;
		gap: 20px;
	}

	.page-label {
		color: var(--accent);
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 2px;
	}

	.cart-header h1 {
		font-size: 36px;
		margin: 8px 0;
	}

	.cart-header p {
		color: var(--muted);
		margin: 0;
	}

	.continue-shopping {
		color: var(--text);
		text-decoration: none;
		border: 1px solid var(--line);
		padding: 12px 18px;
		border-radius: 10px;
		transition: 0.2s;
	}

		.continue-shopping:hover {
			border-color: var(--accent);
			color: var(--accent);
		}

	.cart-container {
		display: grid;
		grid-template-columns: 1fr 340px;
		gap: 25px;
		align-items: start;
	}

	.cart-items,
	.order-summary {
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 16px;
		overflow: hidden;
	}

	.cart-table-header,
	.cart-item {
		display: grid;
		grid-template-columns: 2fr 0.8fr 0.8fr 0.8fr;
		align-items: center;
		gap: 15px;
		padding: 20px;
	}

	.cart-table-header {
		background: rgba(255,255,255,0.03);
		color: var(--muted);
		font-size: 13px;
		font-weight: 600;
		border-bottom: 1px solid var(--line);
	}

	.cart-item {
		border-bottom: 1px solid var(--line);
	}

		.cart-item:last-child {
			border-bottom: none;
		}

	.movie-info {
		display: flex;
		align-items: center;
		gap: 14px;
		min-width: 0;
	}

	.movie-image {
		width: 80px;
		height: 115px;
		flex-shrink: 0;
		overflow: hidden;
		border-radius: 8px;
	}

		.movie-image img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
		}

	.movie-details {
		min-width: 0;
	}

	.movie-info h3 {
		font-size: 15px;
		margin: 0 0 5px;
		overflow-wrap: anywhere;
	}

	.movie-info span {
		color: var(--muted);
		font-size: 12px;
	}

	.remove-btn {
		margin-top: 10px;
		padding: 5px 0;
		border: none;
		background: transparent;
		color: #e05252;
		font-size: 12px;
		cursor: pointer;
		transition: 0.2s;
	}

		.remove-btn:hover {
			color: #ff7777;
		}

	.quantity {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 14px;
		font-weight: 600;
	}

		.quantity form {
			margin: 0;
		}

	.quantity-btn {
		width: 28px;
		height: 28px;
		border: 1px solid var(--line);
		border-radius: 6px;
		background: transparent;
		color: var(--text);
		font-size: 18px;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: 0.2s;
	}

		.quantity-btn:hover {
			background: var(--accent);
			border-color: var(--accent);
			color: white;
		}

	.price,
	.subtotal {
		font-size: 14px;
		font-weight: 600;
	}

	.subtotal {
		color: var(--accent);
	}

	.order-summary {
		padding: 24px;
	}

		.order-summary h2 {
			font-size: 20px;
			margin: 0 0 25px;
		}

	.summary-row {
		display: flex;
		justify-content: space-between;
		gap: 10px;
		margin-bottom: 18px;
		color: var(--muted);
		font-size: 14px;
	}

		.summary-row span:last-child {
			color: var(--text);
			font-weight: 600;
		}

	.summary-divider {
		height: 1px;
		background: var(--line);
		margin: 20px 0;
	}

	.summary-total {
		display: flex;
		justify-content: space-between;
		font-size: 18px;
		font-weight: 700;
		margin-bottom: 25px;
	}

		.summary-total span:last-child {
			color: var(--accent);
		}

	.checkout-btn {
		width: 100%;
		border: none;
		border-radius: 10px;
		padding: 15px;
		background: var(--accent);
		color: white;
		font-size: 15px;
		font-weight: 700;
		cursor: pointer;
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 10px;
		transition: 0.2s;
	}

		.checkout-btn:hover {
			opacity: 0.85;
			transform: translateY(-2px);
		}

	.secure-payment {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 7px;
		color: var(--muted);
		font-size: 12px;
		margin-top: 18px;
	}

		.secure-payment i {
			color: #36b37e;
		}

	@@media (max-width: 850px) {

		.cart-container {
			grid-template-columns: 1fr;
		}
	}

	@@media (max-width: 600px) {

		.cart-header {
			align-items: flex-start;
			flex-direction: column;
		}

		.cart-table-header {
			display: none;
		}

		.cart-item {
			grid-template-columns: 1fr 1fr;
			gap: 15px;
		}

		.movie-info {
			grid-column: 1 / -1;
		}

		.quantity::before {
			content: "Quantity: ";
			color: var(--muted);
			font-weight: 400;
		}

		.price::before {
			content: "Price: ";
			color: var(--muted);
			font-weight: 400;
		}

		.subtotal {
			grid-column: 1 / -1;
		}

			.subtotal::before {
				content: "Subtotal: ";
				color: var(--muted);
				font-weight: 400;
			}
	}
</style>