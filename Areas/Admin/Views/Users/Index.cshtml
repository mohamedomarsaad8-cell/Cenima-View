@model List<ApplicationUser>
@{
	Layout = "_AdminLayout";
	ViewData["Title"] = "Users";

	int currentPage = ViewBag.currentPage ?? 1;
	int totalPages = ViewBag.totalPages ?? 1;
}

@section Styles {
	<style>
		.filters {
			display: flex;
			flex-wrap: wrap;
			gap: 12px;
			align-items: flex-end;
		}

			.filters .form-group {
				margin: 0;
				min-width: 220px;
			}

		.user-id {
			display: inline-block;
			max-width: 110px;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
			vertical-align: bottom;
			font-family: Consolas, "Courier New", monospace;
			font-size: 13px;
			color: var(--muted);
		}

		.user-cell {
			display: flex;
			align-items: center;
			gap: 10px;
		}

		.user-avatar {
			flex: none;
			display: grid;
			place-items: center;
			width: 34px;
			height: 34px;
			border-radius: 50%;
			background: var(--accent);
			color: var(--accent-ink);
			font-weight: 600;
			font-size: 14px;
		}

		.actions form {
			margin: 0;
		}

		.btn-warn {
			background: transparent;
			border-color: var(--accent);
			color: var(--accent);
		}

			.btn-warn:hover {
				background: rgba(232, 182, 76, .14);
			}

		.btn-ok {
			background: transparent;
			border-color: var(--ok);
			color: var(--ok);
		}

			.btn-ok:hover {
				background: rgba(31, 138, 91, .14);
			}

		.pagination {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			gap: 6px;
			list-style: none;
			margin: 24px 0 0;
			padding: 0;
		}

			.pagination .page-link {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				min-width: 40px;
				height: 40px;
				padding: 0 14px;
				border: 1px solid var(--line);
				border-radius: 8px;
				background: var(--surface);
				color: var(--text);
				font-weight: 500;
				text-decoration: none;
				transition: background .15s, border-color .15s, color .15s;
			}

			.pagination .page-item:not(.active):not(.disabled) .page-link:hover {
				background: var(--bg);
				border-color: var(--accent);
			}

			.pagination .page-item.active .page-link {
				background: var(--accent);
				border-color: var(--accent);
				color: var(--accent-ink);
				font-weight: 600;
			}

			.pagination .page-item.disabled .page-link {
				opacity: .4;
				cursor: not-allowed;
				pointer-events: none;
			}

			.pagination .page-link:focus-visible {
				outline: 2px solid var(--accent);
				outline-offset: 2px;
			}

		.empty {
			text-align: center;
			padding: 40px 0;
			color: var(--muted);
		}
	</style>
}

<div class="page-head">
	<p style="margin:0;color:var(--muted)">@Model.Count() users</p>
</div>

<!-- Filters -->
<form method="get" class="card filters" style="margin-bottom:18px">
	<div class="form-group">
		<label for="name">Username or email</label>
		<input id="name" name="Name" class="form-control" placeholder="Search users" />
	</div>
	<button type="submit" class="btn btn-primary">Filter</button>
	<a class="btn" href="/Admin/Users/Index">Clear</a>
</form>

<!-- Table -->
<div class="card">
	@if (Model.Count() == 0)
	{
		<div class="empty">
			No users match your search.
			<a href="/Admin/Users/Index">Clear filters</a>
		</div>
	}
	else
	{
		<div class="table-wrap">
			<table class="table">
				<thead>
					<tr>
						<th>Id</th>
						<th>Username</th>
						<th>Email</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var u in Model)
					{
						var isLocked = u.LockoutEnd != null && u.LockoutEnd > DateTimeOffset.UtcNow;
						var initial = string.IsNullOrEmpty(u.UserName) ? "?" : u.UserName.Substring(0, 1).ToUpper();

						<tr>
							<td><span class="user-id" title="@u.Id">@u.Id</span></td>
							<td>
								<div class="user-cell">
									<span class="user-avatar" aria-hidden="true">@initial</span>
									<span>@u.UserName</span>
									@if (isLocked)
									{
										<span class="badge badge-err">Locked</span>
									}
								</div>
							</td>
							<td>@u.Email</td>
							<td>
								<div class="actions">
									<a href="/Admin/Users/Update/@u.Id" class="btn btn-sm">Edit</a>

									@Html.AntiForgeryToken()
									@if (isLocked)
									{
										<a href="/Admin/Users/LockUnlock/@u.Id" class="btn btn-sm btn-ok">Unlock</a>
									}
									else
									{
										<a href="/Admin/Users/LockUnlock/@u.Id" class="btn btn-sm btn-warn">Lock</a>
									}
									@Html.AntiForgeryToken()
									<a href="/Admin/Users/Delete/@u.Id" class="btn btn-sm btn-danger"
											data-confirm="Delete user “@u.UserName”?">
										Delete
									</a>
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
</div>

<!-- Pagination -->
<nav aria-label="Users pagination">
	<ul class="pagination">
		@if (currentPage > 1)
		{
			<li class="page-item"><a href="/Admin/Users/Index?page=@(currentPage - 1)" class="page-link">Previous</a></li>
		}
		else
		{
			<li class="page-item disabled"><a class="page-link" href="#" tabindex="-1" aria-disabled="true">Previous</a></li>
		}
		@for (int i = 1; i <= totalPages; i++)
		{
			if (i == currentPage)
			{
				<li class="page-item active">
					<a class="page-link" href="#" aria-current="page">@i</a>
				</li>
			}
			else
			{
				<li class="page-item"><a class="page-link" href="/Admin/Users/Index?page=@i">@i</a></li>
			}
		}
		@if (currentPage < totalPages)
		{
			<li class="page-item"><a href="/Admin/Users/Index?page=@(currentPage + 1)" class="page-link">Next</a></li>
		}
		else
		{
			<li class="page-item disabled"><a class="page-link" href="#" tabindex="-1" aria-disabled="true">Next</a></li>
		}
	</ul>
</nav>